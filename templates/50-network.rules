# Managed by Ansible. Local changes will be overwritten.

# Common network configuration
-a always,exit -F path=/etc/hosts -F perm=wa -k network_modifications
-a always,exit -F path=/etc/networks -F perm=wa -k network_modifications

{% if ansible_facts['os_family'] == 'Debian' %}
-a always,exit -F dir=/etc/network -F perm=wa -k network_modifications
{% endif %}

{% if ansible_facts['distribution'] == 'Fedora' %}
-a always,exit -F path=/etc/sysconfig/network -F perm=wa -k network_modifications
-a always,exit -F dir=/etc/NetworkManager -F perm=wa -k network_modifications
{% endif %}

# Login banner configuration
-a always,exit -F path=/etc/issue -F perm=wa -k etcissue
-a always,exit -F path=/etc/issue.net -F perm=wa -k etcissue
